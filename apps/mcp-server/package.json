{
  "name": "@gradeui/mcp-server",
  "version": "0.1.2",
  "description": "Grade Design System MCP server — generate Grade screens from any MCP host (Claude Desktop / Claude Code) on your subscription and save them straight into a Supabase project, where they appear in Studio. A thin stdio adapter over @gradeui/studio/core (createScreenContext + validateAgainstContract).",
  "private": true,
  "license": "UNLICENSED",
  "author": "Grade",
  "type": "module",
  "bin": {
    "gradeui-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tools": "./src/tools.ts",
    "./supabase": "./src/supabase.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gradeui/studio": "workspace:*",
    "@gradeui/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@sparticuz/chromium-min": "147.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "playwright": "~1.59.1",
    "playwright-core": "~1.59.1",
    "typescript": "^5.6.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0"
  }
}
