---
/* Animated WebGL gradient that reads an expressive accent's ramp tokens
   (--gds-expressive-<accent>-{300,700,900}) as its colours, so the shader
   always matches whichever accent the band uses. Drop inside a `relative
   overflow-hidden` Section, behind a `relative z-10` content wrapper.
   Falls back to nothing (the band keeps its flat .expressive bg) if WebGL is
   unavailable, and freezes on prefers-reduced-motion. */
interface Props {
  accent?: string;
  /** `soft` (default) builds light tints from the theme's *primary* hue — an
      airy wash for light bands. `vivid` uses the expressive accent's dark ramp
      stops (the original look) — for dark bands like the CTA. */
  tone?: "soft" | "vivid";
  /** 0–1 canvas opacity, so the shader can sit subtly behind body text
      instead of dominating the band. Defaults to fully opaque. */
  opacity?: number;
}
const { accent = "accent1", tone = "soft", opacity = 1 } = Astro.props;
---

<canvas
  class="gds-shader pointer-events-none absolute inset-0 block h-full w-full"
  data-accent={accent}
  data-tone={tone}
  style={`opacity:${opacity}`}
  aria-hidden="true"></canvas>

<script>
  // Resolve ANY CSS colour string (hex, oklch(), rgb()) to normalised sRGB.
  // A 2D canvas's fillStyle is the only reliable converter: getComputedStyle
  // returns oklch() VERBATIM in Chrome (no rgb normalisation), so parsing its
  // numbers treated the hue as a blue channel — hence the bright-blue hero.
  // Canvas parses CSS Color 4 and getImageData hands back true sRGB bytes.
  const _probe = document.createElement("canvas");
  _probe.width = _probe.height = 1;
  const _pctx = _probe.getContext("2d", { willReadFrequently: true });
  function resolveRgb(value: string): [number, number, number] {
    if (!_pctx) return [0.9, 0.9, 0.9];
    _pctx.fillStyle = "#000";
    _pctx.fillStyle = (value || "").trim() || "#000";
    _pctx.fillRect(0, 0, 1, 1);
    const d = _pctx.getImageData(0, 0, 1, 1).data;
    return [d[0] / 255, d[1] / 255, d[2] / 255];
  }

  const VERT = `attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }`;
  const FRAG = `
    precision highp float;
    uniform vec2 u_res; uniform float u_time;
    uniform vec3 u_c1; uniform vec3 u_c2; uniform vec3 u_c3;
    float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p){
      vec2 i = floor(p), f = fract(p);
      float a = hash(i), b = hash(i + vec2(1.0,0.0));
      float c = hash(i + vec2(0.0,1.0)), d = hash(i + vec2(1.0,1.0));
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
    }
    float fbm(vec2 p){ float v = 0.0, a = 0.5; for(int i=0;i<5;i++){ v += a*noise(p); p *= 2.0; a *= 0.5; } return v; }
    void main(){
      vec2 uv = gl_FragCoord.xy / u_res;
      float t = u_time * 0.04;
      float n = fbm(uv * 2.2 + vec2(t, t * 0.6));
      float m = fbm(uv * 3.1 - vec2(t * 0.5, t * 0.8) + n);
      vec3 col = mix(u_c1, u_c2, smoothstep(0.15, 0.85, n));
      col = mix(col, u_c3, smoothstep(0.4, 0.95, m) * 0.7);
      gl_FragColor = vec4(col, 1.0);
    }`;

  function initShader(canvas: HTMLCanvasElement) {
    // preserveDrawingBuffer keeps the last frame on screen: without it a
    // draw-once canvas (e.g. prefers-reduced-motion) is cleared by the
    // compositor right after — "loads and immediately disappears".
    const gl = canvas.getContext("webgl", { preserveDrawingBuffer: true });
    if (!gl) return;
    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, VERT));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, FRAG));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, "u_res");
    const uTime = gl.getUniformLocation(prog, "u_time");
    const uC1 = gl.getUniformLocation(prog, "u_c1");
    const uC2 = gl.getUniformLocation(prog, "u_c2");
    const uC3 = gl.getUniformLocation(prog, "u_c3");

    // Re-read the colour source from the LIVE custom properties and re-upload
    // the uniforms. Called at init AND whenever the customiser fires
    // `grade:theme-changed`, so a palette/mode switch in the Sheet re-tints the
    // shader instead of leaving it frozen on its load-time colours.
    const applyColors = () => {
      const root = getComputedStyle(document.documentElement);
      let c1: [number, number, number], c2: typeof c1, c3: typeof c1;
      if ((canvas.dataset.tone || "soft") === "vivid") {
        // The expressive accent's dark ramp stops. Suits a dark band.
        const accent = canvas.dataset.accent || "accent1";
        const stop = (s: string) =>
          resolveRgb(root.getPropertyValue(`--gds-expressive-${accent}-${s}`));
        [c1, c2, c3] = [stop("900"), stop("700"), stop("300")];
      } else {
        // Soft: three light tints of the theme's primary hue — an airy wash that
        // reads as a subtle premium gradient over a light band, not dark blobs.
        const p = root.getPropertyValue("--primary").trim().split(/\s+/).map(Number);
        const h = p.length === 3 && !p.some(Number.isNaN) ? p[2] : 250;
        c1 = resolveRgb(`oklch(0.96 0.04 ${h})`);
        c2 = resolveRgb(`oklch(0.90 0.08 ${h})`);
        c3 = resolveRgb(`oklch(0.82 0.13 ${h})`);
      }
      gl.uniform3fv(uC1, c1);
      gl.uniform3fv(uC2, c2);
      gl.uniform3fv(uC3, c3);
      gl.drawArrays(gl.TRIANGLES, 0, 3); // redraw now (covers reduced-motion)
    };
    applyColors();
    window.addEventListener("grade:theme-changed", applyColors);

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, canvas.clientWidth * dpr);
      canvas.height = Math.max(1, canvas.clientHeight * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
    };
    resize();
    window.addEventListener("resize", resize);

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const start = performance.now();
    const frame = () => {
      gl.uniform1f(uTime, reduce ? 0 : (performance.now() - start) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!reduce) requestAnimationFrame(frame);
    };
    frame();
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas.gds-shader").forEach(initShader);
</script>
