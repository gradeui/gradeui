---
import "../styles/global.css";
import {
  Section,
  Container,
  SectionEyebrow,
  SectionTitle,
  SectionSubtitle,
  SectionDescription,
  SectionActions,
  Button,
  Card,
  CardHeader,
  CardTitle,
  CardDescription,
  CardContent,
  Badge,
  MediaSurface,
} from "@gradeui/ui";
import ShaderBackground from "../components/ShaderBackground.astro";
import LocationMap from "../components/LocationMap";
import ContactForm from "../components/ContactForm";
import CustomiseSheet from "../components/CustomiseSheet";

const features = [
  {
    title: "Own the components",
    body: "Install @gradeui/ui like any npm package. No lock-in, no runtime.",
    hint: "product",
    badge: "MIT",
  },
  {
    title: "Themeable bands",
    body: "Each Section carries a scope. Re-skin one band without touching the rest.",
    hint: "album",
    badge: "Scopes",
  },
  {
    title: "Static by default",
    body: "Astro renders to HTML with zero JS. Add client:* only where you need it.",
    hint: "landscape",
    badge: "0 KB JS",
  },
];
---

<!doctype html>
<!-- data-grade-theme engages a coloured palette (teal "energy") purely via CSS.
     Remove it for the neutral default, or swap for another built-in theme id.
     In a real Sites build this attribute is what the per-site theme writes. -->
<html lang="en" data-grade-theme="energy">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Playfair+Display:wght@400;600;700&family=Instrument+Serif:ital@0;1&family=Caveat:wght@400;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <title>Grade × Astro — POC</title>
    <!-- Pre-paint: reconcile the SSR default with the visitor's saved choice
         BEFORE first paint, so there's no theme flash on reload. -->
    <script is:inline>
      (function () {
        try {
          var r = document.documentElement, g = localStorage;
          var t = g.getItem("grade-theme");
          if (t === "default") r.removeAttribute("data-grade-theme");
          else if (t) r.setAttribute("data-grade-theme", t);
          if (g.getItem("grade-mode") === "dark") r.classList.add("dark");
          [["grade-ts-mobile", "data-type-scale-mobile"], ["grade-ts-desktop", "data-type-scale-desktop"], ["grade-ss-mobile", "data-size-scale-mobile"], ["grade-ss-desktop", "data-size-scale-desktop"]].forEach(function (p) {
            var v = g.getItem(p[0]); if (v && v !== "default") r.setAttribute(p[1], v);
          });
          var F = { inter: '"Inter", system-ui, sans-serif', manrope: '"Manrope", system-ui, sans-serif', "space-grotesk": '"Space Grotesk", system-ui, sans-serif', fraunces: '"Fraunces", Georgia, serif', playfair: '"Playfair Display", Georgia, serif', instrument: '"Instrument Serif", Georgia, serif', caveat: '"Caveat", ui-rounded, cursive', "ibm-plex": '"IBM Plex Sans", system-ui, sans-serif' };
          [["grade-font-body", ["--font-sans"]], ["grade-font-heading", ["--font-heading", "--font-display"]], ["grade-font-accent", ["--font-accent"]]].forEach(function (p) {
            var v = g.getItem(p[0]); if (v && v !== "default" && F[v]) p[1].forEach(function (cv) { r.style.setProperty(cv, F[v]); });
          });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-background text-foreground">
    <!-- Hero band — a real, subtle shader behind dark-on-light text. (Dropped
         the old scope="inverse", which deliberately flips dark↔light by mode
         and read as "weirdly white". A faint accent shader gives it life
         without inverting the whole band.) -->
    <Section pad="xl" className="relative overflow-hidden">
      <ShaderBackground tone="soft" opacity={0.85} />
      <Container maxW="lg" className="relative z-10">
        <div class="flex flex-col items-start gap-4">
          <SectionEyebrow>POC</SectionEyebrow>
          <SectionTitle>Built with Grade, rendered by Astro.</SectionTitle>
          <SectionSubtitle>
            Static HTML, zero JS by default. The shader behind this band is the
            only WebGL on the page, and it's purely decorative.
          </SectionSubtitle>
          <SectionActions>
            <Button>Get started</Button>
            <Button variant="outline">Docs</Button>
          </SectionActions>
          <MediaSurface
            hint="landscape"
            alt="Product screenshot"
            radius="lg"
            className="mt-4 w-full"
          />
        </div>
      </Container>
    </Section>

    <!-- Feature grid — Cards with a media thumbnail + a Badge each. -->
    <Section pad="lg">
      <Container maxW="lg">
        <div class="flex flex-col items-start gap-2">
          <SectionEyebrow>Why Grade</SectionEyebrow>
          <SectionTitle>Three primitives doing real work.</SectionTitle>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {
            features.map((f) => (
              <Card>
                <MediaSurface
                  hint={f.hint}
                  alt={f.title}
                  aspect="video"
                  className="w-full"
                />
                <CardHeader>
                  <div class="flex items-center justify-between gap-2">
                    <CardTitle>{f.title}</CardTitle>
                    <Badge variant="info-soft">{f.badge}</Badge>
                  </div>
                  <CardDescription>{f.body}</CardDescription>
                </CardHeader>
              </Card>
            ))
          }
        </div>
      </Container>
    </Section>

    <!-- Media-led split band on a muted scope. -->
    <Section scope="muted" pad="lg">
      <Container maxW="lg">
        <div class="grid items-center gap-8 md:grid-cols-2">
          <div class="flex flex-col items-start gap-4">
            <Badge variant="success-soft">Live</Badge>
            <SectionTitle>Drop media anywhere.</SectionTitle>
            <SectionDescription>
              MediaSurface is the canonical placeholder for any non-person
              image. Pass a hint and alt; the generation pipeline fills it
              later. Here it renders as a static, themed empty state.
            </SectionDescription>
            <SectionActions>
              <Button>See components</Button>
            </SectionActions>
          </div>
          <MediaSurface
            hint="album"
            alt="Square media slot"
            aspect="square"
            radius="lg"
            className="w-full"
          />
        </div>
      </Container>
    </Section>

    <!-- ───────────────────────────────────────────────────────────────
         EXPRESSIVE bands — the highlight layer from STUDIO-EXPRESSIVE, now
         in code. data-expressive picks an accent slot (1–5 = rose/orange/
         amber/yellow/olive), data-expressive-tier picks a tier, and the
         `expressive` class paints the resolved bg+fg. Pure CSS, zero JS.
         ─────────────────────────────────────────────────────────────── -->

    <!-- Three cards, three accents — each card carries its own expressive
         accent, proving the accent layer composes per-element, not just per
         band. (Brought onto the homepage from the CMS demo's accentCards.) -->
    <Section pad="lg">
      <Container maxW="lg">
        <div class="flex flex-col items-start gap-2">
          <SectionEyebrow>Composes anywhere</SectionEyebrow>
          <SectionTitle>Three cards, three accents.</SectionTitle>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          <div
            data-expressive="accent1"
            data-expressive-tier="dark"
            class="expressive flex flex-col rounded-xl p-6 shadow-elevation-2"
          >
            <h3 class="text-lg font-semibold">Accent 1</h3>
            <p class="mt-2 text-sm opacity-80">accent1 on the dark tier.</p>
          </div>
          <div
            data-expressive="accent3"
            data-expressive-tier="light"
            class="expressive flex flex-col rounded-xl p-6 shadow-elevation-2"
          >
            <h3 class="text-lg font-semibold">Accent 3</h3>
            <p class="mt-2 text-sm opacity-80">accent3 on the light tier.</p>
          </div>
          <div
            data-expressive="accent5"
            data-expressive-tier="superdark"
            class="expressive flex flex-col rounded-xl p-6 shadow-elevation-2"
          >
            <h3 class="text-lg font-semibold">Accent 5</h3>
            <p class="mt-2 text-sm opacity-80">accent5 on the superdark tier.</p>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Pricing — ONE accent, TWO tiers: a pale band with a featured dark tile. -->
    <Section
      data-expressive="accent1"
      data-expressive-tier="superlight"
      className="expressive"
      pad="lg"
    >
      <Container maxW="lg">
        <div class="flex flex-col items-center gap-2 text-center">
          <span class="text-xs font-medium uppercase tracking-wider opacity-60">Pricing</span>
          <SectionTitle>One accent, every tier.</SectionTitle>
        </div>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          <div class="rounded-xl border border-current/15 p-6">
            <h3 class="text-lg font-semibold">Starter</h3>
            <p class="mt-1 text-sm opacity-70">For trying things out.</p>
            <p class="mt-5 text-3xl font-semibold">£0</p>
          </div>
          <div
            data-expressive="accent1"
            data-expressive-tier="dark"
            class="expressive rounded-xl p-6"
            style="box-shadow: var(--shadow-lift), var(--shadow-contact)"
          >
            <h3 class="text-lg font-semibold">Pro</h3>
            <p class="mt-1 text-sm opacity-80">The featured plan: same accent, darker tier.</p>
            <p class="mt-5 text-3xl font-semibold">£19</p>
          </div>
          <div class="rounded-xl border border-current/15 p-6">
            <h3 class="text-lg font-semibold">Team</h3>
            <p class="mt-1 text-sm opacity-70">For the whole crew.</p>
            <p class="mt-5 text-3xl font-semibold">£49</p>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Testimonial — accent3 (amber), dark tier. -->
    <Section
      data-expressive="accent3"
      data-expressive-tier="dark"
      className="expressive"
      pad="xl"
    >
      <Container maxW="md">
        <figure class="flex flex-col items-center gap-6 text-center">
          <blockquote class="text-balance text-2xl font-medium md:text-3xl">
            “We shipped a themed marketing site from our own design system in an
            afternoon. The sections just dropped in.”
          </blockquote>
          <figcaption class="text-sm opacity-75">A very happy design-systems person</figcaption>
        </figure>
      </Container>
    </Section>

    <!-- CTA — accent2 (orange), superdark tier, with a palette-driven shader. -->
    <Section
      data-expressive="accent2"
      data-expressive-tier="superdark"
      className="expressive relative overflow-hidden"
      pad="xl"
    >
      <ShaderBackground accent="accent2" tone="vivid" />
      <Container maxW="md" className="relative z-10">
        <div class="flex flex-col items-center gap-4 text-center">
          <SectionTitle>Build vibrant sections, fast.</SectionTitle>
          <p class="max-w-prose text-lg opacity-80">
            Five accents, four tiers, one attribute each. The whole expressive
            layer is just tokens.
          </p>
          <a
            href="#"
            class="mt-2 inline-flex items-center rounded-full border border-current px-5 py-2 text-sm font-medium hover:opacity-80"
            >Get started</a
          >
        </div>
      </Container>
    </Section>

    <!-- Find us — a Grade Map (leaflet default, no API key) as a client island. -->
    <Section pad="lg">
      <Container maxW="lg">
        <div class="flex flex-col items-start gap-3">
          <SectionEyebrow>Find us</SectionEyebrow>
          <SectionTitle>338 Queens Park Road, Brighton.</SectionTitle>
        </div>
        <div class="mt-8">
          <LocationMap client:load lng={-0.1285} lat={50.8252} label="338 Queens Park Road" />
        </div>
      </Container>
    </Section>

    <!-- Contact — a Grade-styled form wired to an Astro Action (src/actions).
         The page stays static; only the action endpoint is server-rendered. -->
    <Section scope="muted" pad="lg">
      <Container maxW="lg">
        <div class="grid items-start gap-10 md:grid-cols-2">
          <div class="flex flex-col items-start gap-3">
            <SectionEyebrow>Get in touch</SectionEyebrow>
            <SectionTitle>Tell us about your project.</SectionTitle>
            <SectionDescription>
              Built on Astro Actions — type-safe, server-validated, with inline
              field errors. Swap the stubbed send for Resend when you're ready.
            </SectionDescription>
          </div>
          <ContactForm client:load />
        </div>
      </Container>
    </Section>

    <!-- Page-surface band — no scope = the default theme. -->
    <Section pad="lg">
      <Container maxW="lg">
        <div class="flex flex-col items-start gap-3">
          <SectionTitle>Stack sections to build the page.</SectionTitle>
          <SectionSubtitle>
            Each band is independently themeable — change a scope, re-skin one
            section without touching the rest.
          </SectionSubtitle>
        </div>
      </Container>
    </Section>
    <!-- Theme switcher — flips data-grade-theme (and .dark) on <html>. Pure
         attribute swap, vanilla JS, no framework island. This is the same
         mechanism a real Sites build uses; here it's wired to a control. -->
    <CustomiseSheet client:load />
  </body>
</html>
