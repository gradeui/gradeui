# ══════════════════════════════════════════════════════════════════
#  Auth + cloud storage
# ══════════════════════════════════════════════════════════════════
# Supabase handles auth (Google OAuth, email magic-link) AND cloud
# storage for Studio (projects, teams, orgs, comments). Resend sends
# the actual emails (magic-link delivery + invitations).
#
# Local-first guarantee: if NEXT_PUBLIC_SUPABASE_URL is empty,
# Studio falls back to localStorage-only mode and the sign-in gate
# is bypassed entirely. `pnpm dev` works out of the box without
# any of these keys.
#
# When the keys ARE present, Studio requires sign-in.
#
# Setup walkthrough: ../../SETUP-AUTH.md

# Supabase project URL + anon key.
# 1. Create a project at https://supabase.com
# 2. Settings → API → Project URL + anon public key
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only. Used by the invitation route
# to insert pending users + access grants (bypasses RLS). Never
# expose to the browser. Settings → API → service_role secret.
# SUPABASE_SERVICE_ROLE_KEY=

# Which sign-in methods are enabled, comma-separated.
# Supported: `google`, `email` (magic-link). Order = button order.
# Both providers must ALSO be enabled in the Supabase dashboard
# (Authentication → Providers) — this env var just decides which
# buttons render. Default if unset: "google,email".
# NEXT_PUBLIC_GRADE_AUTH_PROVIDERS=google,email

# Resend API key — used for invitation emails and (via Supabase
# SMTP) for the magic-link delivery. Get one at https://resend.com
# RESEND_API_KEY=

# From-address for Grade-sent emails (invitations etc). Must be on
# a domain you've verified in Resend. The magic-link FROM address
# is configured separately in the Supabase dashboard's SMTP
# settings.
# GRADE_EMAIL_FROM="Grade <noreply@gradeui.com>"

# Image generation provider.
#   - default (unset)        → Pollinations (keyless, free, no setup)
#   - MEDIA_PROVIDER=gemini   → Gemini Flash Image (requires key + free-tier
#                               eligible Google project; better quality)
# MEDIA_PROVIDER=

# Pollinations model variant (only used when MEDIA_PROVIDER=pollinations or
# default). Common: "flux", "flux-realism", "flux-anime", "flux-3d", "turbo".
# POLLINATIONS_MODEL=flux

# Gemini Flash Image (only used when MEDIA_PROVIDER=gemini)
# Free tier from https://aistudio.google.com/. Either env var name works.
# Note: free tier requires billing enabled on the Google Cloud project;
# unbilled projects hit "limit: 0" 429s on the first request.
# GEMINI_API_KEY=
# Override the image model name when Google rotates a name and we haven't
# bumped the package default. See https://ai.google.dev/gemini-api/docs/models
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Storage driver for generated images.
#   - "local-tmp"   → writes to os.tmpdir(), served via /api/media/[file]
#   - "vercel-blob" → writes to Vercel Blob, served from the blob CDN
# Auto-selected based on process.env.VERCEL when unset. Set explicitly to
# force a particular driver (e.g. test the prod path locally).
# MEDIA_STORAGE_DRIVER=local-tmp

# Vercel Blob token — auto-injected by Vercel when a Blob store is attached
# to the project. Only needed when MEDIA_STORAGE_DRIVER=vercel-blob.
# BLOB_READ_WRITE_TOKEN=

# @gradeui/skills providers — at least one is required for skill-based passes
# (image-describer, a11y-reviewer, qa, etc). The runner picks Google first
# (free tier — gemini-2.5-flash) and falls through to Anthropic / OpenAI
# only if Google isn't configured.
# Get a free Google AI Studio key: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Free-tier safety flag. When set to "1" or "true", the runner refuses to
# resolve to any paid provider — even via explicit override or skill pref.
# Recommended during testing / local dev to guarantee you can't accidentally
# rack up Anthropic / OpenAI charges.
# GRADE_FREE_TIER_ONLY=1
