{
  "name": "@gradeui/core",
  "version": "1.0.0",
  "description": "Grade Design System — foundations. Primitive design tokens (color ramps, neutrals, semantic aliases, spacing, radii, font stacks, type scale) as CSS (tokens.css) + typed data (GDS_* exports). Theme engine migration still pending — see README.",
  "license": "MIT",
  "author": "Grade",
  "homepage": "https://gradeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gradeui/gradeui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gradeui/gradeui/issues"
  },
  "keywords": [
    "grade",
    "design-tokens",
    "oklch",
    "theming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens.css": "./styles/tokens.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs",
    "prebuild": "npm run generate",
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "echo \"(no lint configured for @gradeui/core yet)\"",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
