    "./loader": "./src/loader.ts",
    "./runner": "./src/runner.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint": "echo \"(no lint configured for @gradeui/skills yet)\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/google": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "ai": "^6.0.0",
    "gray-matter": "^4.0.3",
