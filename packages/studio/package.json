{
  "name": "@gradeui/studio",
  "version": "0.2.0",
  "description": "Grade Design System Studio — the chat+preview workbench for designing UIs against @gradeui/ui. Houses the playbook (model-facing knowledge), and will eventually house the UI chrome and Sandpack runtime.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Grade",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./playbook": "./src/playbook/index.ts",
    "./core": "./src/core/index.ts",
    "./registry": "./src/registry/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "generate:sidecars": "node scripts/generate-sidecars.mjs",
    "generate:scaffolds": "node scripts/generate-scaffolds.mjs",
    "gen:scaffolds-playground": "node scripts/generate-scaffolds-playground.mjs",
    "generate": "pnpm run generate:sidecars && pnpm run generate:scaffolds && pnpm run gen:scaffolds-playground",
    "prebuild": "pnpm run generate",
    "lint": "echo \"(no lint configured for @gradeui/studio yet)\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gradeui/contracts": "workspace:*",
    "typescript": "^5.6.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20"
  }
}
