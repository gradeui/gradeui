{
  "name": "gradeui",
  "version": "0.0.0",
  "private": true,
  "description": "Grade UI — design system monorepo (@gradeui/core, @gradeui/ui, @gradeui/pro) + docs site",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:all": "pnpm -r build",
    "build:docs": "pnpm --filter @gradeui/docs build",
    "dev": "pnpm --filter @gradeui/docs dev",
    "dev:consume": "pnpm --filter @gradeui/consume-app dev",
    "motion:setup": "pnpm --filter @gradeui/docs add -D ffmpeg-static && pnpm --filter @gradeui/docs exec playwright install chromium",
    "motion:render": "node scripts/render-motion.mjs",
    "motion:preview": "node scripts/render-motion.mjs --res 0.5 --fps 30",
    "motion:1x": "node scripts/render-motion.mjs --res 1 --fps 30",
    "motion:2x": "node scripts/render-motion.mjs --res 2 --fps 60",
    "motion:poster": "node scripts/render-motion.mjs --poster --width 640",
    "motion:loop": "node scripts/render-motion.mjs --seconds 3 --width 480 --fps 24",
    "motion:superpixel": "node scripts/render-motion.mjs --seconds 2 --width 240 --fps 20",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist .next .turbo node_modules && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gradeui/gradeui.git"
  },
  "homepage": "https://gradeui.com",
  "bugs": {
    "url": "https://github.com/gradeui/gradeui/issues"
  },
  "license": "MIT",
  "author": "Grade"
}
