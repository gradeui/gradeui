{
  "name": "gradeui",
  "version": "0.0.0",
  "private": true,
  "description": "Grade UI — design system monorepo (@grade/core, @grade/ui, @grade/pro) + docs site",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "build:all": "pnpm -r build",
    "build:docs": "pnpm --filter @grade/docs build",
    "dev": "pnpm --filter @grade/docs dev",
    "dev:consume": "pnpm --filter @grade/consume-app dev",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist .next .turbo node_modules && rm -rf node_modules",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gradeui/gradeui.git"
  },
  "homepage": "https://gradeui.com",
  "bugs": {
    "url": "https://github.com/gradeui/gradeui/issues"
  },
  "license": "MIT",
  "author": "Grade"
}
